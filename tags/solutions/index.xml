</span></span></span><span style="display:flex;"><span><span style="color:#6e7681">          </span><span style="color:#ff7b72">AND</span><span style="color:#6e7681"> </span>updated_at<span style="color:#6e7681"> </span><span style="color:#ff7b72;font-weight:bold">&gt;</span><span style="color:#6e7681"> </span>t.updated_at<span style="color:#6e7681"> </span>)<span style="color:#6e7681"> </span>)<span style="color:#6e7681"> </span>t2<span style="color:#6e7681"> </span><span style="color:#ff7b72">ON</span><span style="color:#6e7681"> </span>t2.user_id<span style="color:#6e7681"> </span><span style="color:#ff7b72;font-weight:bold">=</span><span style="color:#6e7681"> </span>t1.id<span style="color:#6e7681">
