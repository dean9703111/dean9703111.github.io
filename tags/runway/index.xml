</figure>


</div>

<h3 id="-人像">➤ 人像<a class="h-anchor" href="#-%e4%ba%ba%e5%83%8f" aria-label="這個段落的連結"></a></h3>
<div class="gallery-row cols-2">

<figure class="figure"><img src="https://deanlin.net/blog/202307/midjourney-runway-gen2-animation/images/midjourney-runway-gen2-animation-16.webp" width="1090" height="603" alt="人像（圖 16）" loading="lazy" decoding="async">
