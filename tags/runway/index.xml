</figure>


</div>

<div class="gallery-row cols-2">

<figure class="figure"><img src="https://deanlin.net/blog/202307/midjourney-runway-gen2-animation/images/midjourney-runway-gen2-animation-20.webp" width="1400" height="785" alt="結語（圖 20）" loading="lazy" decoding="async">
</figure>

<figure class="figure figure-video">
  <video class="gifv" muted loop playsinline controls preload="none" poster="https://deanlin.net/blog/202307/midjourney-runway-gen2-animation/images/midjourney-runway-gen2-animation-21.webp" width="896" height="512" aria-label="原本希望在沙漠前行，結果變成了鬼步" data-gifv>
