  <span class="lc-thumb">
    <img src="https://deanlin.net/blog/202308/runway-video-editing-tools/images/runway-video-editing-tools-card-01_hu_31b2732656cc6583.webp" width="320" height="320" alt="" loading="lazy" decoding="async">
