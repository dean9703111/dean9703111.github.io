  <span class="lc-thumb">
    <img src="https://deanlin.net/blog/202407/ai-generated-chart-mockups/images/ai-generated-chart-mockups-card-01_hu_8d8826cf792098e.webp" width="320" height="320" alt="" loading="lazy" decoding="async">
