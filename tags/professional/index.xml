  </span>
  <span class="lc-thumb">
    <img src="https://deanlin.net/blog/202312/does-your-design-solve-the-problem/images/does-your-design-solve-the-problem-card-01_hu_1fa33569279a75fa.webp" width="320" height="320" alt="" loading="lazy" decoding="async">
  </span>
</a>

]]></content:encoded>
