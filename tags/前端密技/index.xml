</span></span><span style="display:flex;"><span>  schema<span style="color:#ff7b72;font-weight:bold">:</span> { type<span style="color:#ff7b72;font-weight:bold">:</span> <span style="color:#a5d6ff">&#39;array&#39;</span>, items<span style="color:#ff7b72;font-weight:bold">:</span> { properties<span style="color:#ff7b72;font-weight:bold">:</span> [Object], required<span style="color:#ff7b72;font-weight:bold">:</span> [Array] } },
